SECRET_KEY=replace-with-a-random-secret-before-production

# Discord Bot token (server-side only)
DISCORD_BOT_TOKEN=

# Discord OAuth2 application (not the Bot token)
# Used when DISCORD_CLIENT_ID is empty (same application ID)
DISCORD_BOT_CLIENT_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
# Set true when serving the site over HTTPS
SESSION_COOKIE_SECURE=false
